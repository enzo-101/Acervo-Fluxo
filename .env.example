# ----------------------------------------------------------------------------
# Copie este arquivo para `.env` e ajuste o que quiser. Tudo tem padrao sensato.
# ----------------------------------------------------------------------------

# Onde fica o banco SQLite.
DB_PATH=./data/ranking.db

# Fuso horario usado no resumo diario e nos cortes de semana/mes.
TZ=America/Sao_Paulo

# Numero do bot, com DDI e DDD, so digitos (ex.: 5521999998888).
# Preenchido, o pareamento passa a ser por um codigo de 8 caracteres em vez de
# QR code — necessario quando o bot roda em servidor, porque QR em log de nuvem
# sai quebrado e expira em 20 segundos. Vazio = QR code, como antes.
BOT_PHONE_NUMBER=

# ----------------------------------------------------------------------------
# Pipefy (comandos !pipe e aviso de lead novo). Sem PIPEFY_TOKEN, as duas
# funcoes ficam desligadas e o bot segue servindo so o ranking.
# ----------------------------------------------------------------------------

# Token de API do Pipefy (Configuracoes > Tokens de API).
PIPEFY_TOKEN=

# ID do pipe, visivel na URL: app.pipefy.com/pipes/156763
PIPEFY_PIPE_ID=156763

# Por quanto tempo o resultado do !pipe fica em cache, em segundos.
# Evita que varias pessoas pedindo seguido martelem a API.
PIPEFY_CACHE_SECONDS=180

# Com que frequencia o bot procura leads novos (formato cron).
# Padrao: a cada 2 minutos.
LEAD_POLL_CRON=*/2 * * * *

# Idade maxima de um card para ele ainda contar como "lead novo", em horas.
# Protege contra um card antigo reaparecer por causa de edicao.
LEAD_MAX_AGE_HOURS=24

# Teto de leads anunciados por rodada. O excedente e registrado em silencio,
# para uma importacao em massa nao virar enxurrada no grupo.
LEAD_MAX_POR_RODADA=5

# Verbosidade da biblioteca de WhatsApp: silent, error, warn, info, debug, trace.
# Deixe em `silent` no dia a dia; suba para `debug` se precisar investigar.
LOG_LEVEL=silent

# Horario do resumo diario, em formato cron (min hora dia mes dia-da-semana).
# Padrao: todo dia as 20:00.
DAILY_SUMMARY_CRON=0 20 * * *

# Se `true`, o resumo diario so e postado em grupos que tiveram pelo menos
# uma contribuicao nas ultimas 24h. Se `false`, posta todo dia em todo grupo.
DAILY_SUMMARY_ONLY_IF_ACTIVE=true

# Como o bot confirma cada contribuicao detectada:
#   reaction -> so reage com um emoji na mensagem (discreto, recomendado)
#   reply    -> responde com uma linha curta
#   both     -> reage e responde
#   silent   -> nao confirma nada, so registra
CONFIRM_MODE=reaction

# Emoji da reacao de confirmacao.
CONFIRM_EMOJI=📚

# Prefixos aceitos para comandos, separados por virgula.
COMMAND_PREFIXES=!,/

# Quantos itens no maximo uma unica mensagem pode pontuar.
# Evita que alguem cole 30 links de uma vez e dispare no ranking.
MAX_ITEMS_PER_MESSAGE=3

# Teto de contribuicoes por pessoa por dia. 0 = sem limite.
MAX_ITEMS_PER_PERSON_PER_DAY=0

# Quantas posicoes o ranking mostra.
RANKING_SIZE=10

# Quando o bot volta do ar, o WhatsApp entrega a fila do periodo offline e ela
# e contabilizada normalmente. Mensagens mais velhas que isto (em dias) sao
# ignoradas, para a primeira conexao nao despejar material antigo no ranking.
# 0 = sem limite.
MAX_MESSAGE_AGE_DAYS=7

# Contar videos/audios/imagens enviados como midia nativa (nao como documento)?
# Padrao `false`: um video encaminhado costuma ser meme, nao material de estudo.
COUNT_NATIVE_MEDIA=false

# Dedup de arquivos por hash do conteudo (baixa a midia para calcular o SHA-256).
# Mais preciso, porem mais pesado. Com `false`, o dedup usa nome + tamanho.
DEDUP_FILES_BY_HASH=false

# Escopo por assunto. Vazio = vale em todo grupo.
# RANKING_GROUPS: onde o bot conta contribuicoes e responde !ranking/!meu.
# PIPE_GROUPS:    onde ele responde !pipe e anuncia lead novo do Pipefy.
# Separe os dois para que dado comercial nao apareca no grupo do acervo.
RANKING_GROUPS=
PIPE_GROUPS=

# Restringe o bot a grupos especificos (IDs separados por virgula, ex.:
# 120363000000000000@g.us). Vazio = funciona em todo grupo em que ele estiver.
ALLOWED_GROUPS=

# Dominios extras que devem contar como conhecimento (separados por virgula).
EXTRA_KNOWLEDGE_DOMAINS=

# Dominios que nunca devem contar, mesmo que batam em alguma regra.
EXTRA_BLOCKED_DOMAINS=
